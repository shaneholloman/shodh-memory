{
  "default": "withhold",
  "rules": [
    { "match": "mcp__shodh__recall*",        "effect": "allow",    "reason": "Reading memory is the seat's purpose." },
    { "match": "mcp__shodh__list_*",         "effect": "allow",    "reason": "Listing is read-only." },
    { "match": "mcp__shodh__search_*",       "effect": "allow",    "reason": "Search is read-only." },
    { "match": "mcp__shodh__explore_entity", "effect": "allow",    "reason": "Graph exploration is read-only." },
    { "match": "mcp__shodh__trace_lineage",  "effect": "allow",    "reason": "Provenance is the thing we want it to show." },
    { "match": "mcp__shodh__remember",       "effect": "allow",    "reason": "Writes are ledgered and revertible." },
    { "match": "mcp__shodh__forget",         "effect": "withhold", "reason": "Deletion is an operator action, not an agent action." },
    { "match": "mcp__shodh__purge_*",        "effect": "withhold", "reason": "Bulk deletion is never delegated." },
    { "match": "mcp__shodh__backup_*",       "effect": "withhold", "reason": "Backup and restore move the whole store." },
    { "match": "mcp__shodh__repair_index",   "effect": "withhold", "reason": "Index surgery is an operator action." },
    { "match": "mcp__shodh__reset_*",        "effect": "withhold", "reason": "Resets are irreversible from the agent's side." }
  ]
}
